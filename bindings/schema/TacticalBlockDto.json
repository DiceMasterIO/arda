        },
        "lights": {
          "description": "Light sources.",
          "items": {
            "$ref": "#/$defs/SceneLightDto"
          },
          "type": "array"
        },
        "movement": {
          "$ref": "#/$defs/Runs",
          "description": "Per-square movement."
        },
        "name": {
          "description": "Layout name.",
          "type": "string"
        },
        "obscured": {
          "$ref": "#/$defs/Runs4",
          "description": "Per-square obscurement."
        },
        "origin_gs": {
          "description": "World square of square `(0, 0)` (I17): present in\n`TacticalBlockDto.scene`, absent in `TacticalScene.scene`, whose\nenvelope carries it.",
