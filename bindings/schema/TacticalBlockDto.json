  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`GET /v1/tactical/cell/{gx}/{gy}` and `GET /v1/tactical/window`: one\nworld-derived block or window (logic/16 §api-tactical).",
  "properties": {
    "layout": {
      "$ref": "#/$defs/TacticalLayoutDto",
      "description": "What the compositor draws."
    },
    "layout_schema": {
      "description": "`TacticalLayout` schema version ([`LAYOUT_SCHEMA`]).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "meta": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Provenance: `source`, `relaxed`, `overlays`, `demo_at`, ….",
      "type": "object"
    },
    "origin": {
      "description": "Top-left square in world squares (64 per cell); equals `layout.origin`.",
      "items": {
        "format": "int64",
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "render_seed": {
      "description": "Compositor seed of the images (a decimal string); the scene resolves\nasset queries with the same seed.",
      "type": "string"
    },
    "rules": {
      "anyOf": [
        {
          "$ref": "#/$defs/RulesSidecarDto"
        },
        {
          "type": "null"
        }
      ],
      "description": "Per-square rules, `arda-scene` `RulesSidecar` format 2, or `null`."
    },
    "scene": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneDto"
        },
        {
          "type": "null"
        }
      ],
      "description": "Scene data from the same layout (`arda-scene` `Scene`, format 1:\nmovement, climb, cover, obscurement, walls, lights, regions, spawn\nhints), or `null` when not requested."
    },
    "size": {
      "description": "Width and height in squares.",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "tactical_format": {
      "description": "Envelope version of this body ([`TACTICAL_FORMAT`]).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "tiles": {
      "$ref": "#/$defs/TacticalTilesDto",
      "description": "Tile pyramid geometry at the requested ppsq."
    }
  },
  "required": [
    "tactical_format",
    "layout_schema",
    "origin",
    "size",
    "render_seed",
    "layout",
    "meta",
    "tiles"
  ],
  "title": "TacticalBlockDto",
  "type": "object"
}
