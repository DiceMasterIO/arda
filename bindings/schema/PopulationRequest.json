    "BuildingSpec": {
      "additionalProperties": false,
      "description": "One building of a settlement.",
      "properties": {
        "capacity": {
          "description": "Resident capacity.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "function": {
          "$ref": "#/$defs/BuildingFunction",
          "description": "What the building is for."
        },
        "id": {
          "description": "Building id, unique within the settlement.",
          "type": "string"
        },
        "settlement_id": {
          "description": "Owning settlement id.",
          "type": "string"
        },
        "tags": {
          "description": "Free tags such as `craft:weaving`; omitted when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "wealth": {
          "description": "Building wealth, 0–255.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "workplace_slots": {
          "description": "Workplace slots, master included.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "settlement_id",
        "function",
        "capacity",
        "workplace_slots",
        "wealth"
      ],
      "type": "object"
    },
