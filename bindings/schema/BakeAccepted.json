{
  "$defs": {
    "BakeIgnored": {
      "description": "Posted items a bake could not place in its cell (review 3.6-9): walls\noff the cell's edges, placements and lights anchored outside it. A\nbake ignores them, and says so here, instead of dropping them silently.",
      "properties": {
        "lights": {
          "description": "Lights placed outside the cell.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "placements": {
          "description": "Placements anchored outside the cell (a placement on its east or\nsouth border line belongs to the neighbour).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "walls": {
          "description": "Wall segments on no edge of the cell.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "walls",
        "placements",
        "lights"
      ],
      "type": "object"
    },
    "BakeState": {
      "description": "Where a bake job stands.",
      "oneOf": [
        {
          "const": "queued",
          "description": "Waiting for the bake lane.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Rendering and encoding.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Tiles ready to download.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Finished with `error`.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`202` (or `200` once done) body of `POST /v1/tactical/bake`\n(TS `BakeAccepted`).",
  "properties": {
    "format_version": {
      "description": "Body version ([`BAKE_FORMAT`]).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "generator_version": {
      "default": "",
      "description": "The release that bakes it (`server_version`); part of the job id.\nAdded in 0.9; absent before.",
      "type": "string"
    },
    "ignored": {
      "$ref": "#/$defs/BakeIgnored",
      "default": {
        "lights": 0,
        "placements": 0,
        "walls": 0
      },
      "description": "Posted items the bake ignores (none for a body the cell route\nsent). Added in 0.9; absent before."
    },
    "job_id": {
      "description": "Content-addressed job id (32 hex digits): the same body against the\nsame world and library always gets the same id.",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/BakeState",
      "description": "Where the job stands now."
    },
    "status_url": {
      "description": "Where to poll: `/v1/tactical/bake/{job_id}`.",
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "job_id",
    "state",
    "status_url"
  ],
  "title": "BakeAccepted",
  "type": "object"
}
