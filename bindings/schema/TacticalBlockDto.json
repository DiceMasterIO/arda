            "format": "int64",
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "regions": {
          "description": "Difficult-terrain and water regions.",
          "items": {
            "$ref": "#/$defs/RegionDto"
          },
          "type": "array"
        },
        "seed": {
