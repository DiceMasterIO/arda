        "width",
        "height",
        "seed",
        "library",
        "library_version",
        "movement",
        "climb",
        "cover",
        "obscured",
        "elevation_ft",
        "water_depth_ft",
        "walls",
        "vision_blockers",
        "lights",
        "regions",
        "spawn_hints",
        "tokens"
      ],
      "type": "object"
    },
