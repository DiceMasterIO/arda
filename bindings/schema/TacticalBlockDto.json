        },
        "tokens": {
          "description": "NPC token slots.",
          "items": {
            "$ref": "#/$defs/TokenSlotDto"
          },
          "type": "array"
        },
        "vision_blockers": {
          "description": "Canopy and prop polygons that obscure vision.",
          "items": {
            "$ref": "#/$defs/VisionBlockerDto"
          },
          "type": "array"
        },
        "walls": {
