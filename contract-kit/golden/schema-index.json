{
  "api_version": "v1",
  "dialect": "https://json-schema.org/draft/2020-12/schema",
  "format_version": 1,
  "note": "Schemas describe Arda's own NPC shape; a server started with --sheet-mapping reshapes every Npc it serves (header X-Arda-Sheet-Mapping) and the Npc parts of these schemas no longer apply to it.",
  "schemas": [
    {
      "family": "api_version",
      "name": "ApiError",
      "routes": [
        "every 4xx and 5xx response"
      ],
      "stability": "stable",
      "url": "/v1/schema/ApiError.json"
    },
    {
      "family": "contract_version",
      "name": "AreaCells",
      "routes": [
        "GET /v1/area/{ax}/{ay}/cells?format=json"
      ],
      "stability": "stable",
      "url": "/v1/schema/AreaCells.json"
    },
    {
      "family": "contract_version",
      "name": "AreaLakes",
      "routes": [
        "GET /v1/area/{ax}/{ay}/lakes"
      ],
      "stability": "stable",
      "url": "/v1/schema/AreaLakes.json"
    },
    {
      "family": "contract_version",
      "name": "AreaRivers",
      "routes": [
        "GET /v1/area/{ax}/{ay}/rivers"
      ],
      "stability": "stable",
      "url": "/v1/schema/AreaRivers.json"
    },
    {
      "family": "bake_format",
      "name": "BakeAccepted",
      "routes": [
        "POST /v1/tactical/bake"
      ],
      "stability": "stable",
      "url": "/v1/schema/BakeAccepted.json"
    },
    {
      "family": "bake_format",
      "name": "BakeRequest",
      "routes": [
        "POST /v1/tactical/bake (request)"
      ],
      "stability": "stable",
      "url": "/v1/schema/BakeRequest.json"
    },
    {
      "family": "bake_format",
      "name": "BakeStatus",
      "routes": [
        "GET /v1/tactical/bake/{id}"
      ],
      "stability": "stable",
      "url": "/v1/schema/BakeStatus.json"
    },
    {
      "family": "contract_version",
      "name": "CellSample",
      "routes": [
        "GET /v1/cell/{gx}/{gy}"
      ],
      "stability": "stable",
      "url": "/v1/schema/CellSample.json"
    },
    {
      "family": "tactical_format",
      "name": "DungeonDto",
      "routes": [
        "GET /v1/tactical/dungeon"
      ],
      "stability": "stable",
      "url": "/v1/schema/DungeonDto.json"
    },
    {
      "family": "realm_format",
      "name": "Event",
      "routes": [
        "RealmDetail.events[]"
      ],
      "stability": "stable",
      "url": "/v1/schema/Event.json"
    },
    {
      "family": "gazetteer_format",
      "name": "Gazetteer",
      "routes": [
        "GET /v1/gazetteer"
      ],
      "stability": "stable",
      "url": "/v1/schema/Gazetteer.json"
    },
    {
      "family": "gazetteer_format",
      "name": "GazetteerFeature",
      "routes": [
        "Gazetteer.features[]",
        "society/gazetteer.json"
      ],
      "stability": "stable",
      "url": "/v1/schema/GazetteerFeature.json"
    },
    {
      "family": "gazetteer_format",
      "name": "GazetteerPoint",
      "routes": [
        "Gazetteer.features[]"
      ],
      "stability": "stable",
      "url": "/v1/schema/GazetteerPoint.json"
    },
    {
      "family": "npc_format",
      "name": "GenerateNpcRequest",
      "routes": [
        "POST /v1/npc/generate (request)"
      ],
      "stability": "stable",
      "url": "/v1/schema/GenerateNpcRequest.json"
    },
    {
      "family": "contract_version",
      "name": "Health",
      "routes": [
        "GET /v1/health"
      ],
      "stability": "stable",
      "url": "/v1/schema/Health.json"
    },
    {
      "family": "api_version",
      "name": "NotYetError",
      "routes": [
        "501 from /v1/tactical/cell and /window (PendingBlocks test seam only)"
      ],
      "stability": "debug",
      "url": "/v1/schema/NotYetError.json"
    },
    {
      "family": "npc_format",
      "name": "Npc",
      "routes": [
        "GET /v1/npc/{id}",
        "GET /v1/npc/demo/{npc_id}",
        "POST /v1/npc/generate"
      ],
      "stability": "stable",
      "url": "/v1/schema/Npc.json"
    },
    {
      "family": "npc_format",
      "name": "NpcDemo",
      "routes": [
        "GET /v1/npc/demo"
      ],
      "stability": "debug",
      "url": "/v1/schema/NpcDemo.json"
    },
    {
      "family": "npc_page_format",
