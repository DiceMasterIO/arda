      "routes": [
        "RealmDetail.relations[]"
      ],
      "stability": "stable",
      "url": "/v1/schema/Relation.json"
    },
    {
      "family": "rules_sidecar_format",
      "name": "RulesSidecarDto",
      "routes": [
        "TacticalBlockDto.rules",
        "DungeonDto.rules"
      ],
      "stability": "stable",
      "url": "/v1/schema/RulesSidecarDto.json"
    },
    {
      "family": "scene_format",
      "name": "SceneDto",
      "routes": [
        "GET /v1/tactical/dungeon/scene",
        "TacticalBlockDto.scene",
        "TacticalScene.scene"
      ],
      "stability": "stable",
      "url": "/v1/schema/SceneDto.json"
    },
    {
      "family": "schema_index_format",
      "name": "SchemaIndex",
      "routes": [
        "GET /v1/schema"
      ],
      "stability": "stable",
      "url": "/v1/schema/SchemaIndex.json"
    },
    {
      "family": "settlement_format",
      "name": "Settlement",
      "routes": [
