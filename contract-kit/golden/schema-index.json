      "routes": [
        "GET /v1/npcs",
        "GET /v1/buildings/{building}/residents",
        "GET /v1/buildings/{building}/workers"
      ],
      "stability": "stable",
      "url": "/v1/schema/NpcPage.json"
    },
    {
      "family": "contract_version",
      "name": "PointSample",
      "routes": [
        "GET /v1/point"
      ],
      "stability": "stable",
      "url": "/v1/schema/PointSample.json"
    },
    {
      "family": "npc_format",
      "name": "Population",
      "routes": [
        "POST /v1/npc/population"
      ],
      "stability": "stable",
      "url": "/v1/schema/Population.json"
    },
    {
      "family": "npc_format",
      "name": "PopulationRequest",
      "routes": [
        "POST /v1/npc/population (request)"
      ],
      "stability": "stable",
      "url": "/v1/schema/PopulationRequest.json"
    },
    {
      "family": "tactical_format",
      "name": "PrefetchAccepted",
      "routes": [
        "POST /v1/tactical/prefetch"
      ],
      "stability": "stable",
      "url": "/v1/schema/PrefetchAccepted.json"
    },
    {
      "family": "tactical_format",
      "name": "PrefetchRequest",
      "routes": [
        "POST /v1/tactical/prefetch (request)"
      ],
      "stability": "stable",
      "url": "/v1/schema/PrefetchRequest.json"
    },
    {
      "family": "realm_format",
      "name": "Realm",
      "routes": [
        "RealmDetail.record"
      ],
      "stability": "stable",
      "url": "/v1/schema/Realm.json"
    },
    {
      "family": "realm_format",
      "name": "RealmDetail",
      "routes": [
        "GET /v1/realms/{id}"
      ],
      "stability": "stable",
      "url": "/v1/schema/RealmDetail.json"
    },
