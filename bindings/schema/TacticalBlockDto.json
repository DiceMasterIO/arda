            "$ref": "#/$defs/SceneWallDto"
          },
          "type": "array"
        },
        "water_depth_ft": {
          "$ref": "#/$defs/Runs2",
          "description": "Per-square water depth in feet."
        },
        "width": {
          "description": "Width in squares.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
