    "SettlementProfile": {
      "additionalProperties": false,
      "description": "One settlement to populate.",
      "properties": {
        "ancestry_mix": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "default": null,
          "description": "Optional ancestry weights replacing the culture's table.",
          "type": [
            "object",
            "null"
          ]
        },
        "biome": {
          "$ref": "#/$defs/Biome",
          "description": "Biome."
        },
        "coastal": {
          "description": "On a sea coast.",
          "type": "boolean"
        },
        "culture": {
          "description": "Culture key.",
          "type": "string"
        },
        "functions": {
          "description": "Economic functions.",
          "items": {
            "$ref": "#/$defs/SettlementFunction"
          },
          "type": "array"
        },
        "id": {
          "description": "Settlement id.",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "population": {
          "description": "Number of inhabitants.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "realm_id": {
          "description": "Realm id.",
          "type": "string"
        },
        "riverine": {
          "description": "On a river.",
          "type": "boolean"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "Size class."
        },
        "tongue": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tongue"
            },
            {
              "type": "null"
            }
          ],
          "description": "The local speech the settlement was named in (`arda_names::Tongue`)."
        },
        "wealth": {
          "description": "Wealth, 0–255.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "tier",
        "population",
        "functions",
        "wealth",
        "culture",
        "realm_id",
        "biome",
        "coastal",
        "riverine"
      ],
      "type": "object"
    },
    "Tier": {
      "description": "Settlement size class.",
      "oneOf": [
        {
          "const": "hamlet",
          "description": "Hamlet.",
          "type": "string"
        },
        {
          "const": "village",
          "description": "Village.",
          "type": "string"
        },
        {
          "const": "town",
          "description": "Town.",
          "type": "string"
        },
        {
          "const": "city",
          "description": "City.",
          "type": "string"
        }
      ]
    },
    "Tongue": {
      "additionalProperties": false,
      "description": "Recipe of a place's local speech (`arda_names::Tongue`): seeds are\ndecimal strings.",
      "properties": {
        "dialect_seed": {
          "description": "Seed of the region's dialect map.",
          "type": "string"
        },
        "height": {
          "description": "Dialect map height, cells.",
          "format": "int64",
          "type": "integer"
        },
        "language_seed": {
          "description": "Seed of the standard language.",
          "type": "string"
        },
        "preset": {
          "description": "Culture preset key (`heartland`, `sylvan`, …).",
          "type": "string"
        },
        "substrate_seed": {
          "description": "Seed of the shared substrate tongue.",
          "type": "string"
        },
        "width": {
          "description": "Dialect map width, cells.",
          "format": "int64",
          "type": "integer"
        },
        "x": {
          "description": "Place column, cells.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "Place row, cells.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "preset",
        "language_seed",
        "substrate_seed",
        "dialect_seed",
        "width",
        "height",
        "x",
        "y"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /v1/npc/population`.",
  "properties": {
    "buildings": {
      "description": "Its buildings.",
      "items": {
        "$ref": "#/$defs/BuildingSpec"
      },
      "type": "array"
    },
    "settlement": {
      "$ref": "#/$defs/SettlementProfile",
      "description": "The settlement to populate."
    },
    "world_seed": {
      "description": "World seed as a decimal string.",
      "type": "string"
    }
  },
  "required": [
    "world_seed",
    "settlement",
    "buildings"
  ],
  "title": "PopulationRequest",
  "type": "object"
}
