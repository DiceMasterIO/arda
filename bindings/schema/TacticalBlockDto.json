{
  "$defs": {
    "AssetClassDto": {
      "description": "Catalogue asset classes.",
      "oneOf": [
        {
          "const": "ground",
          "description": "Tileable ground texture.",
          "type": "string"
        },
        {
          "const": "wall",
          "description": "Wall-kit piece.",
          "type": "string"
        },
        {
          "const": "prop",
          "description": "Furniture, goods, vehicles and structures.",
          "type": "string"
        },
        {
          "const": "vegetation",
          "description": "Trees, bushes, reeds and rocks.",
          "type": "string"
        },
        {
          "const": "water",
          "description": "Tileable water texture.",
          "type": "string"
        }
      ]
    },
    "AssetRefDto": {
      "description": "An asset chosen by id or by a deterministic tag query.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A specific asset id.",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Any asset of the class carrying every tag.",
          "properties": {
            "query": {
              "properties": {
                "class": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/AssetClassDto"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Restrict to a class."
                },
                "tags": {
                  "description": "Required tags.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "tags"
              ],
              "type": "object"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        }
      ]
    },
    "BlockerKindDto": {
      "description": "Where a vision blocker comes from.",
      "oneOf": [
        {
          "const": "canopy",
          "description": "A tree canopy.",
          "type": "string"
        },
        {
          "const": "prop",
          "description": "A prop that blocks sight.",
          "type": "string"
        }
      ]
    },
    "CoverLevelDto": {
      "description": "SRD 5.1 degrees of cover.",
      "oneOf": [
        {
          "const": "none",
          "description": "No cover.",
          "type": "string"
        },
        {
          "const": "half",
          "description": "Half cover: +2 AC and Dexterity saves.",
          "type": "string"
        },
        {
          "const": "three_quarters",
          "description": "Three-quarters cover: +5.",
          "type": "string"
        },
        {
          "const": "total",
          "description": "Total cover: cannot be targeted directly.",
          "type": "string"
        }
      ]
    },
    "EdgeAxisDto": {
      "description": "Which edge of a square a segment lies on.",
      "oneOf": [
        {
          "const": "horizontal",
          "description": "The north edge of square `(x, y)`.",
          "type": "string"
        },
        {
          "const": "vertical",
          "description": "The west edge of square `(x, y)`.",
          "type": "string"
        }
      ]
    },
    "EdgeDto": {
      "description": "A map edge.",
      "oneOf": [
        {
          "const": "N",
          "description": "North (y = 0).",
          "type": "string"
        },
        {
          "const": "E",
          "description": "East.",
          "type": "string"
        },
        {
          "const": "S",
          "description": "South.",
          "type": "string"
        },
        {
          "const": "W",
          "description": "West (x = 0).",
          "type": "string"
        }
      ]
    },
    "EdgeExitDto": {
      "additionalProperties": false,
      "description": "A run of enterable squares along one map edge.",
      "properties": {
        "edge": {
          "$ref": "#/$defs/EdgeDto",
          "description": "Which edge."
        },
        "from": {
          "$ref": "#/$defs/SqDto",
          "description": "First square of the run."
        },
        "to": {
          "$ref": "#/$defs/SqDto",
          "description": "Last square of the run (inclusive)."
        }
      },
      "required": [
        "edge",
        "from",
        "to"
      ],
      "type": "object"
    },
    "EdgeRoleDto": {
      "description": "Why a rules edge exists.",
      "oneOf": [
        {
          "const": "parapet",
          "description": "Bridge parapet: blocks movement, not sight.",
          "type": "string"
        },
        {
          "const": "retaining",
          "description": "Low retaining wall.",
          "type": "string"
        },
        {
          "const": "building",
          "description": "A building's wall, door or window.",
          "type": "string"
        },
        {
          "const": "boundary",
          "description": "Hedge, drystone wall or fence around a field.",
          "type": "string"
        },
        {
          "const": "gate",
          "description": "A gate in a field boundary.",
          "type": "string"
        }
      ]
    },
    "EdgeRuleDto": {
      "additionalProperties": false,
      "description": "Movement and sight rules of one unit edge.",
      "properties": {
        "axis": {
          "$ref": "#/$defs/EdgeAxisDto",
          "description": "Which edge of the square."
        },
        "blocks_movement": {
          "description": "Blocks movement across the edge.",
          "type": "boolean"
        },
        "blocks_sight": {
          "description": "Blocks sight across the edge.",
          "type": "boolean"
        },
        "cover": {
          "$ref": "#/$defs/CoverLevelDto",
          "default": "none",
          "description": "Cover it grants."
        },
        "role": {
          "$ref": "#/$defs/EdgeRoleDto",
          "description": "Why it is there."
        },
        "x": {
          "description": "Square column.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "description": "Square row.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "axis",
        "role",
        "blocks_movement",
        "blocks_sight"
      ],
      "type": "object"
    },
    "EntranceDto": {
      "additionalProperties": false,
      "description": "Squares beside a door or gate.",
      "properties": {
        "squares": {
          "description": "Enterable squares on either side of it.",
          "items": {
            "$ref": "#/$defs/SqDto"
          },
          "type": "array"
        },
        "wall": {
          "description": "Index into `walls`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wall",
        "squares"
      ],
      "type": "object"
    },
    "LightSourceDto": {
      "additionalProperties": false,
      "description": "A light source not attached to an asset.",
      "properties": {
        "colour": {
          "description": "RGB colour.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "radius_ft": {
          "description": "Bright-light radius in feet.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "description": "Position in squares.",
          "format": "float",
          "type": "number"
        },
        "y": {
          "description": "Position in squares.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "radius_ft",
        "colour"
      ],
      "type": "object"
    },
    "MovementDto": {
      "description": "How a creature moves through a square (SRD 5.1 \"Movement\").",
      "oneOf": [
        {
          "const": "normal",
          "description": "Ordinary ground.",
          "type": "string"
        },
        {
          "const": "difficult",
          "description": "Difficult terrain: every foot costs 1 extra foot.",
          "type": "string"
        },
        {
          "const": "wade",
          "description": "Shallow water (1–4 ft): wading, as difficult terrain.",
          "type": "string"
        },
        {
          "const": "swim",
          "description": "Water 5 ft deep or more: swimming.",
          "type": "string"
        },
        {
          "const": "impassable",
          "description": "Solid obstacle; cannot be entered.",
          "type": "string"
        }
      ]
    },
    "ObscurementDto": {
      "description": "SRD 5.1 vision obscurement of a square.",
      "oneOf": [
        {
          "const": "clear",
          "description": "Clear.",
          "type": "string"
        },
        {
          "const": "light",
          "description": "Lightly obscured.",
          "type": "string"
        },
        {
          "const": "heavy",
          "description": "Heavily obscured or opaque.",
          "type": "string"
        }
      ]
    },
    "PlacementDto": {
      "additionalProperties": false,
      "description": "A prop or vegetation placement.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/AssetRefDto",
          "description": "What to place."
        },
        "mirror": {
          "default": false,
          "description": "Horizontal mirror, applied before rotation.",
          "type": "boolean"
        },
        "rotation": {
          "default": 0,
          "description": "Clockwise rotation in degrees.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "description": "Anchor position in squares (`3.5` is a square centre).",
          "format": "float",
          "type": "number"
        },
        "y": {
          "description": "Anchor position in squares.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "asset",
        "x",
        "y"
      ],
      "type": "object"
    },
    "RegionDto": {
      "additionalProperties": false,
      "description": "Merged squares of one kind as closed rings on grid vertices (even-odd fill).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RegionKindDto",
          "description": "What the region marks."
        },
        "rings": {
          "description": "Closed rings of `[x, y]` vertices (first point not repeated).",
          "items": {
            "items": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "rings"
      ],
      "type": "object"
    },
    "RegionKindDto": {
      "description": "What a region marks.",
      "oneOf": [
        {
          "const": "difficult",
          "description": "Difficult terrain on land.",
          "type": "string"
        },
        {
          "const": "shallow_water",
          "description": "Shallow water (wading).",
          "type": "string"
        },
        {
          "const": "deep_water",
          "description": "Deep water (swimming).",
          "type": "string"
        }
      ]
    },
    "RulesCellDto": {
      "additionalProperties": false,
      "description": "One square's rules; an absent field means \"no opinion\".",
      "properties": {
        "blocks_movement": {
          "description": "Impassable.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "blocks_sight": {
          "description": "Heavily obscured.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cover": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverLevelDto"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cover the square's contents grant."
        },
        "deck": {
          "description": "A walkable deck (bridge, jetty) over the square.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "difficult": {
          "description": "Difficult terrain.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "ext": {
          "additionalProperties": true,
          "description": "Layer extras: `feature`, `road_class`, `deck_elevation_ft` (ways),\n`crop`, `field`, `furrow` (fields), `building` (town).",
          "type": [
            "object",
            "null"
          ]
        },
        "lightly_obscured": {
          "description": "Lightly obscured.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "water_depth_ft": {
          "description": "Water depth in feet: under 5 wades, 5 or more swims (I15).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RulesSidecarDto": {
      "additionalProperties": false,
      "description": "The per-square rules sidecar, format 2.",
      "properties": {
        "edges": {
          "default": [],
          "description": "Low edge features that are not wall-kit walls (always present on\nthe wire; the domain JSON omits an empty list).",
          "items": {
            "$ref": "#/$defs/EdgeRuleDto"
          },
          "type": "array"
        },
        "format_version": {
          "description": "Always 2.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "description": "Height in squares.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "squares": {
          "description": "Row-major cells.",
          "items": {
            "$ref": "#/$defs/RulesCellDto"
          },
          "type": "array"
        },
        "width": {
          "description": "Width in squares (the layout's).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "format_version",
        "width",
        "height",
        "squares"
      ],
      "type": "object"
    },
    "Runs": {
      "description": "A row-major per-square layer as runs `[[count, value], …]`, expanding to\n`width × height` values (`arda_scene::Grid`).",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/MovementDto"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "Runs2": {
      "description": "A row-major per-square layer as runs `[[count, value], …]`, expanding to\n`width × height` values (`arda_scene::Grid`).",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "Runs3": {
      "description": "A row-major per-square layer as runs `[[count, value], …]`, expanding to\n`width × height` values (`arda_scene::Grid`).",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/CoverLevelDto"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "Runs4": {
      "description": "A row-major per-square layer as runs `[[count, value], …]`, expanding to\n`width × height` values (`arda_scene::Grid`).",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          {
            "$ref": "#/$defs/ObscurementDto"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "Runs5": {
      "description": "A row-major per-square layer as runs `[[count, value], …]`, expanding to\n`width × height` values (`arda_scene::Grid`).",
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          {
            "format": "int16",
            "maximum": 32767,
            "minimum": -32768,
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "SceneDto": {
