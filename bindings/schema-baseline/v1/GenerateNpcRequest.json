          "description": "Male.",
          "type": "string"
        }
      ]
    },
    "SocialRank": {
      "description": "Standing in local society.",
      "oneOf": [
        {
          "const": "dependent",
          "description": "Children and dependants.",
          "type": "string"
        },
        {
          "const": "labourer",
          "description": "Labourers, hands and servants.",
          "type": "string"
        },
        {
          "const": "tradesfolk",
          "description": "Journeymen, clerks and small traders.",
          "type": "string"
        },
        {
          "const": "master",
          "description": "Masters, owners and minor officials.",
          "type": "string"
        },
        {
          "const": "gentry",
