orts":{"grain":11,"timber":8},"local_use":{"ale":34,"cloth":4,"fish":24,"grain":178,"ironware":7,"leather":3,"livestock":54,"salt":7,"timber":21,"wool":4},"production":{"ale":59,"cloth":4,"fish":109,"grain":178,"ironware":25,"leather":3,"livestock":66,"salt":29,"timber":21,"wool":34},"shortfall":{"cloth":4,"grain":73,"leather":4,"ore":37},"stored":{"fish":75,"wool":30}},"market":true,"trade_balance_sp":4730},"faction_relations":[{"a":"f10.commons","b":"f10.shrine","reason":"The Keepers of the Shrine of the Lady of the Ford keep the old feast days that the tenants of Sefeethfe love.","stance":"friendly"}],"factions":[{"goals":["Keep the old feast days alive","Find out who has been leaving offerings at night"],"id":"f10.shrine","influence":16,"kind":"shrine","kind_label":"shrine keepers","leader_role":"r10.shrine_keeper","name":"the Keepers of the Shrine of the Lady of the Ford","seat_building":3,"settlement":"10"},{"goals":["Overturn the lord's new tax on every catch","Raise a chapel for the drowned"],"id":"f10.fishers","influence":15,"kind":"fishers","kind_label":"fishers' league","leader_role":"r10.fisher_head","name":"the Fishers' League of Sefeethfe","seat_building":2,"settlement":"10"},{"goals":["See the tithe cut after a lean year","Keep the young from leaving for the towns"],"id":"f10.commons","influence":18,"kind":"commons","kind_label":"commons","leader_role":"r10.commons_voice","name":"the tenants of Sefeethfe","seat_building":8,"settlement":"10"}],"founded":105,"founded_from":"4","founding_event":116,"history_hooks":[{"refs":[{"id":"10","kind":"settlement"}],"text":"Grew at the mouth of the Mymotwesles","year":null},{"refs":[{"id":"4","kind":"settlement"}],"text":"Sefeethfe began in 105 RH as a summer camp of herders from Fethyose and slowly became a place of its own.","year":105},{"refs":[{"id":929,"kind":"event"}],"text":"The flood of 288 RH took the old mill and half the lower fields. Wind and a spring tide held back the Geaflow in 288, and the water had to go somewhere.","year":288},{"refs":[{"key":"ironware","kind":"good"},{"id":"4","kind":"settlement"}],"text":"Its ironware goes out along the road to Fethyose, and has for generations.","year":null}],"hooks":[{"id":"h10.embargo","kind":"embargo","refs":[{"id":"10","kind":"settlement"},{"id":"214","kind":"settlement"},{"id":"2","kind":"realm"},{"id":"215","kind":"road"},{"id":"r10.reeve","kind":"role"}],"tension":74,"text":"Grand Syndic Geadeth has closed the track to Elefeth in Sweyemlel, and wagons stand idle in Sefeethfe. The Reeve of Sefeethfe is under orders to turn back every cart, and under pressure to let a few through.","title":"By Order of the Crown"},{"id":"h10.aftermath","kind":"aftermath","refs":[{"id":"10","kind":"settlement"},{"id":"r10.shrine_keeper","kind":"role"},{"id":929,"kind":"event"}],"tension":58,"text":"5 years after the flood of 288, the Keeper of the Sefeethfe Shrine still keeps the list of the dead. Someone has begun digging in the old burial pits.","title":"Unquiet Graves"},{"id":"h10.rising_water","kind":"rising_water","refs":[{"id":"10","kind":"settlement"},{"id":"r10.reeve","kind":"role"},{"id":929,"kind":"event"}],"tension":51,"text":"Silt from the flood of 288 buried a boundary stone, and now two families of Sefeethfe claim the same field. The Reeve of Sefeethfe wants the stone dug up before the ploughing.","title":"The Drowned Fields"},{"id":"h10.wolf_winter","kind":"wolf_winter","refs":[{"id":"10","kind":"settlement"},{"id":"r10.reeve","kind":"role"}],"tension":40,"text":"A shepherd from Sefeethfe came down from the forest edge raving about eyes in the dark and refuses to go back. The flock is still up there.","title":"The Last Shepherd"}],"id":"10","name":"Sefeethfe","prosperity":{"present":114,"samples":[[105,49],[125,23],[150,57],[175,73],[200,81],[225,81],[250,99],[275,99],[293,114]],"trend":"recovering"},"realm_id":"1","roles":[{"building":"7","class":null,"duties":"Answers to the lord for the village's dues and labour days.","faction":null,"family_name":null,"female":null,"given_name":null,"id":"r10.reeve","kind":"reeve","settlement":"10","stat_block":"commoner","title":"Reeve of Sefeethfe"},{"building":"3","class":null,"duties":"Tends the shrine and keeps the feast days.","faction":"f10.shrine","family_name":null,"female":null,"given_name":null,"id":"r10.shrine_keeper","kind":"shrine_keeper","settlement":"10","stat_block":"acolyte","title":"Keeper of the Sefeethfe Shrine"},{"building":"1","class":null,"duties":"Assigns berths, collects harbour dues and watches the tides.","faction":null,"family_name":null,"female":null,"given_name":null,"id":"r10.harbourmaster","kind":"harbourmaster","settlement":"10","stat_block":"scout","title":"Harbourmaster of Sefeethfe"},{"building":"2","class":null,"duties":"Speaks for the boats and shares out the fishing grounds.","faction":"f10.fishers","family_name":null,"female":null,"given_name":null,"id":"r10.fisher_head","kind":"fisher_head","settlement":"10","stat_block":"commoner","title":"Headman of the Sefeethfe Fishers"},{"building":"8","class":null,"duties":"Speaks for the common folk at moots and to the lord.","faction":"f10.commons","family_name":null,"female":null,"given_name":null,"id":"r10.commons_voice","kind":"commons_voice","settlement":"10","stat_block":"commoner","title":"Voice of the Sefeethfe Commons"}]}}