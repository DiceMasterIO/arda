{
  "$defs": {
    "Biome": {
      "description": "The biome a settlement reports, serialised snake_case.",
      "oneOf": [
        {
          "const": "temperate",
          "description": "Open temperate lowland: farmland and grass (the default).",
          "type": "string"
        },
        {
          "const": "warm_temperate",
          "description": "Warm temperate lowland, 15 °C mean or more.",
          "type": "string"
        },
        {
          "const": "temperate_forest",
          "description": "Broadleaf or mixed forest.",
          "type": "string"
        },
        {
          "const": "boreal_forest",
          "description": "Cold conifer forest, under 6 °C mean.",
          "type": "string"
        },
        {
          "const": "highland",
          "description": "Hills and mountains, 5 °C mean or more.",
          "type": "string"
        },
        {
          "const": "alpine",
          "description": "Mountains under 5 °C mean.",
          "type": "string"
        },
        {
          "const": "wetland",
          "description": "Beside marsh or fen.",
          "type": "string"
        },
        {
          "const": "steppe",
          "description": "Dry grassland.",
          "type": "string"
        },
        {
          "const": "coastal",
          "description": "On the sea coast.",
          "type": "string"
        }
      ]
    },
    "BuildingRef": {
      "description": "One building as society sees it.",
      "properties": {
        "function": {
          "description": "Building-function key (plain snake_case).",
          "type": "string"
        },
        "id": {
          "description": "Building id, unique within the settlement.",
          "type": "string"
        },
        "tags": {
          "description": "Free tags; a workshop carries `craft:<name>`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "type": "object"
    },
    "ClassLevel": {
      "description": "An SRD 5.1 class and level.",
      "properties": {
        "class": {
          "description": "SRD class name.",
          "type": "string"
        },
        "level": {
          "description": "Level.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "class",
        "level"
      ],
      "type": "object"
    },
    "EntityRef": {
      "description": "A reference to one entity of the input world or of the society.",
      "oneOf": [
        {
          "description": "An input settlement.",
          "properties": {
            "id": {
              "description": "Settlement id.",
              "type": "string"
            },
            "kind": {
              "const": "settlement",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "An input realm.",
          "properties": {
            "id": {
              "description": "Realm id.",
              "type": "string"
            },
            "kind": {
              "const": "realm",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "An input road.",
          "properties": {
            "id": {
              "description": "Road id.",
              "type": "string"
            },
            "kind": {
              "const": "road",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A building of a settlement.",
          "properties": {
            "id": {
              "description": "Building id within the settlement.",
              "type": "string"
            },
            "kind": {
              "const": "building",
              "type": "string"
            },
            "settlement": {
              "description": "Settlement id.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "settlement",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A faction.",
          "properties": {
            "id": {
              "description": "Faction id.",
              "type": "string"
            },
            "kind": {
              "const": "faction",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A notable NPC slot.",
          "properties": {
            "id": {
              "description": "Role id.",
              "type": "string"
            },
            "kind": {
              "const": "role",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A ruin of an abandoned settlement.",
          "properties": {
            "id": {
              "description": "Ruin id.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "ruin",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A timeline event.",
          "properties": {
            "id": {
              "description": "Event id.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "event",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A ruling house.",
          "properties": {
            "id": {
              "description": "Dynasty id.",
              "type": "string"
            },
            "kind": {
              "const": "dynasty",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A trade good.",
          "properties": {
            "key": {
              "description": "Good key.",
              "type": "string"
            },
            "kind": {
              "const": "good",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        }
      ]
    },
    "Faction": {
      "description": "One faction.",
      "properties": {
        "goals": {
          "description": "What it wants.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "Stable id (`f<settlement>.<kind>`).",
          "type": "string"
        },
        "influence": {
          "description": "Influence, 0–100.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "Kind key.",
          "type": "string"
        },
        "kind_label": {
          "description": "Readable kind.",
          "type": "string"
        },
        "leader_role": {
          "description": "Leader NPC slot.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "seat_building": {
          "description": "Building it meets in.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "settlement": {
          "description": "Settlement.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "settlement",
        "kind",
        "kind_label",
        "name",
        "goals",
        "leader_role",
        "influence"
      ],
      "type": "object"
    },
    "FactionRelation": {
      "description": "Stance between factions `a < b` (by id) of one settlement.",
      "properties": {
        "a": {
          "description": "Lower faction id.",
          "type": "string"
        },
        "b": {
          "description": "Higher faction id.",
          "type": "string"
        },
        "reason": {
          "description": "Why.",
          "type": "string"
        },
        "stance": {
          "$ref": "#/$defs/FactionStance",
          "description": "Stance."
        }
      },
      "required": [
        "a",
        "b",
        "stance",
        "reason"
      ],
      "type": "object"
    },
    "FactionStance": {
      "description": "How two factions stand.",
      "oneOf": [
        {
          "const": "allied",
          "description": "Working together.",
          "type": "string"
        },
        {
          "const": "friendly",
          "description": "On good terms.",
          "type": "string"
        },
        {
          "const": "rival",
          "description": "Competing.",
          "type": "string"
        },
        {
          "const": "hostile",
          "description": "Openly hostile.",
          "type": "string"
        }
      ]
    },
    "Function": {
      "description": "What a settlement lives on (`arda-npc` `SettlementFunction`).",
      "oneOf": [
        {
          "const": "farming",
          "description": "Arable fields.",
          "type": "string"
        },
        {
          "const": "pastoral",
          "description": "Herds and flocks.",
          "type": "string"
        },
        {
          "const": "fishing",
          "description": "Inshore or river fishing.",
          "type": "string"
        },
        {
          "const": "port",
          "description": "A harbour with sea or river trade.",
          "type": "string"
        },
        {
          "const": "market",
          "description": "A regular market.",
          "type": "string"
        },
        {
          "const": "mining",
          "description": "Mines or quarries.",
          "type": "string"
        },
        {
          "const": "logging",
          "description": "Forestry and charcoal.",
          "type": "string"
        },
        {
          "const": "crafting",
          "description": "Workshops and guilds.",
          "type": "string"
        },
        {
          "const": "fortress",
          "description": "A garrison or castle.",
          "type": "string"
        },
        {
          "const": "abbey",
          "description": "A religious house.",
          "type": "string"
        },
        {
          "const": "crossing",
          "description": "A ford, bridge or ferry.",
          "type": "string"
        },
        {
          "const": "capital",
          "description": "The seat of a realm.",
          "type": "string"
        }
      ]
    },
    "GoodRole": {
      "description": "How a key good moves through a market.",
      "oneOf": [
        {
          "const": "export",
          "description": "Mostly sent out.",
          "type": "string"
        },
        {
          "const": "import",
          "description": "Mostly brought in.",
          "type": "string"
        },
        {
          "const": "transit",
          "description": "Mostly carried through to elsewhere.",
          "type": "string"
        }
      ]
    },
    "HistoryHook": {
      "description": "One line of settlement history.",
      "properties": {
        "refs": {
          "description": "Entities it mentions.",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "text": {
          "description": "The line.",
          "type": "string"
        },
        "year": {
          "description": "Year it refers to, if any.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "refs"
      ],
      "type": "object"
    },
    "Hook": {
      "description": "One plot hook.",
      "properties": {
        "id": {
          "description": "Stable id (`h<settlement>.<kind>` or `hr<realm>.<kind>`).",
          "type": "string"
        },
        "kind": {
          "description": "Kind key.",
          "type": "string"
        },
        "refs": {
          "description": "Entities involved.",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "tension": {
          "description": "How hot the tension is, 0–100.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "Two or three sentences for the referee.",
          "type": "string"
        },
        "title": {
          "description": "Title.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "text",
        "tension",
        "refs"
      ],
      "type": "object"
    },
    "KeyGood": {
      "description": "One of a market's key trade goods.",
      "properties": {
        "good": {
          "description": "Good key.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/GoodRole",
          "description": "Dominant direction."
        },
        "value_sp": {
          "description": "Value handled per year, silver pieces.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "good",
        "role",
        "value_sp"
      ],
      "type": "object"
    },
    "Ledger": {
      "description": "Where each load of one settlement went.",
      "properties": {
        "demand": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Loads wanted.",
          "type": "object"
        },
        "exports": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Loads sent out.",
          "type": "object"
        },
        "imports": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Loads brought in.",
          "type": "object"
        },
        "local_use": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Own production used at home.",
          "type": "object"
        },
        "production": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Loads produced.",
          "type": "object"
        },
        "shortfall": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Demand left unmet.",
          "type": "object"
        },
        "stored": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Surplus nobody could reach.",
          "type": "object"
        }
      },
      "required": [
        "production",
        "demand",
        "local_use",
        "exports",
        "imports",
        "stored",
        "shortfall"
      ],
      "type": "object"
    },
    "NpcRole": {
      "description": "One notable NPC slot.",
      "properties": {
        "building": {
          "default": null,
          "description": "Workplace building.",
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassLevel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Suggested SRD 5.1 class and level."
        },
        "duties": {
          "description": "What the role does.",
          "type": "string"
        },
        "faction": {
          "description": "Faction led, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "family_name": {
          "description": "Family name fixed by history.",
          "type": [
            "string",
            "null"
          ]
        },
        "female": {
          "description": "Sex fixed by history.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "given_name": {
          "description": "Given name fixed by history (rulers, vassals).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable id.",
          "type": "string"
        },
        "kind": {
          "description": "Role kind key (`ruler`, `captain`, `high_priest`, …).",
          "type": "string"
        },
        "settlement": {
          "description": "Settlement.",
          "type": "string"
        },
        "stat_block": {
          "description": "Suggested SRD 5.1 NPC stat block.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Title as the NPC would be addressed.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "settlement",
        "kind",
        "title",
        "duties"
      ],
      "type": "object"
    },
    "Preset": {
      "description": "A culture or ancestry preset.",
      "oneOf": [
        {
          "const": "heartland",
          "description": "Mellow lowland farming folk.",
          "type": "string"
        },
        {
          "const": "highland",
          "description": "Clipped, consonant-heavy hill folk.",
          "type": "string"
        },
        {
          "const": "sylvan",
          "description": "Soft, breathy forest folk.",
          "type": "string"
        },
        {
          "const": "coastal",
          "description": "Harsh northern seafarers.",
          "type": "string"
        },
        {
          "const": "southern",
          "description": "Flowing, open-syllabled warm-country folk.",
          "type": "string"
        },
        {
          "const": "borderland",
          "description": "Steppe marchfolk with vowel harmony.",
          "type": "string"
        },
        {
          "const": "dwarvish",
          "description": "Dwarvish: heavy, closed, back-vowelled.",
          "type": "string"
        },
        {
          "const": "elvish",
          "description": "Elvish: sibilant, vowel-rich, end-stressed.",
          "type": "string"
        },
        {
          "const": "halfling",
          "description": "Halfling: bouncy, homely, doubled consonants.",
          "type": "string"
        },
        {
          "const": "gnomish",
          "description": "Gnomish: quick, long, buzzing.",
          "type": "string"
        },
        {
          "const": "orcish",
          "description": "Orcish: guttural with glottal breaks.",
          "type": "string"
        },
        {
          "const": "draconic",
          "description": "Draconic: hissing, rolling, long vowels.",
          "type": "string"
        },
        {
          "const": "infernal",
          "description": "Infernal: dark, sonorous, buzzing.",
          "type": "string"
        },
        {
          "const": "ancient",
          "description": "The pre-settlement substrate tongue river names come from.",
          "type": "string"
        }
      ]
    },
    "Prosperity": {
      "description": "Prosperity history of one settlement.",
      "properties": {
        "present": {
          "description": "Present wealth, 0–255 (the input value).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "description": "`[year, wealth]` samples from founding to present.",
          "items": {
            "items": {
              "format": "int32",
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "trend": {
          "$ref": "#/$defs/Trend",
          "description": "Current direction."
        }
      },
      "required": [
        "present",
        "trend",
        "samples"
      ],
      "type": "object"
    },
    "Settlement": {
      "description": "One settlement, as written to `society/settlements.json`.",
      "properties": {
        "biome": {
          "$ref": "#/$defs/Biome",
          "description": "Biome, from a closed list."
        },
        "buildings": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Estimated building mix: building function → count.",
          "type": "object"
        },
        "cell_x": {
          "description": "Centre cell column.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cell_y": {
          "description": "Centre cell row.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "coastal": {
          "description": "On a sea coast.",
          "type": "boolean"
        },
        "culture": {
          "description": "Culture key (`arda-npc` `data/content/cultures.json`).",
          "type": "string"
        },
        "functions": {
          "description": "Economic functions, sorted.",
          "items": {
            "$ref": "#/$defs/Function"
          },
          "type": "array"
        },
        "height_m": {
          "description": "Ground height at the centre, metres.",
          "format": "int32",
          "type": "integer"
        },
        "history": {
          "description": "A one-line origin hook for the referee.",
          "type": "string"
        },
        "id": {
          "description": "Stable identifier, 1-based in placement order (a JSON string, I5).",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "name_gloss": {
          "description": "English gloss of the name (\"Oakford\"); `name` is the native form.",
          "type": "string"
        },
        "population": {
          "description": "Inhabitants.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rank": {
          "description": "Rank among towns and cities (1 = largest); 0 for villages and hamlets.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "realm_id": {
          "description": "Owning realm, 1-based (a JSON string, I5).",
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "riverine": {
          "description": "On a river.",
          "type": "boolean"
        },
        "site_tags": {
          "description": "Descriptive site tags (see the README).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "Size class."
        },
        "tongue": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tongue"
            },
            {
              "type": "null"
            }
          ],
          "description": "The local speech the name was drawn in, for naming the settlement's\npeople in the same dialect (A5)."
        },
        "wealth": {
          "description": "Overall wealth, 0–255.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "x_m": {
          "description": "Centre, metres east of the world's west edge.",
          "format": "int64",
          "type": "integer"
        },
        "y_m": {
          "description": "Centre, metres south of the world's north edge.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "tier",
        "population",
        "functions",
        "wealth",
        "culture",
        "realm_id",
        "biome",
        "coastal",
        "riverine",
        "name_gloss",
        "x_m",
        "y_m",
        "cell_x",
        "cell_y",
        "height_m",
        "rank",
        "site_tags",
        "history",
        "buildings"
      ],
      "type": "object"
    },
    "SettlementEconomy": {
      "description": "Economy of one settlement.",
      "properties": {
        "key_goods": {
          "description": "Key trade goods (markets only), most valuable first.",
          "items": {
            "$ref": "#/$defs/KeyGood"
